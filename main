local fpsFrames = 0
local fpsCount = 0
local lastTime = tick()

RunService.RenderStepped:Connect(function()
    fpsFrames = fpsFrames + 1
    local currentTime = tick()
    if currentTime - lastTime >= 1 then
        fpsCount = fpsFrames
        fpsFrames = 0
        lastTime = currentTime
        
        local ping = 0
        pcall(function() ping = math.floor(LP:GetNetworkPing() * 1000) end)
        
        statsLabel.Text = string.format("FPS: %d | PING: %dms", fpsCount, ping)
    end
end)

--// Drop Logic
local dropEnabled = false
local _wfConns = {}

local function toggleDrop(state)
    dropEnabled = state
    
    if dropEnabled then
        local colConn = RunService.Stepped:Connect(function()
            if not dropEnabled then return end
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP and p.Character then
                    for _, part in ipairs(p.Character:GetChildren()) do
                        if part:IsA("BasePart") then 
                            part.CanCollide = false 
                        end
                    end
                end
            end
        end)
        table.insert(_wfConns, colConn)

        task.spawn(function()
            while dropEnabled do
                RunService.Heartbeat:Wait()
                local c = LP.Character
                local root = c and c:FindFirstChild("HumanoidRootPart")
                
                if not root then continue end
                
                local vel = root.Velocity
                root.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
                
                RunService.RenderStepped:Wait()
                if root and root.Parent then root.Velocity = vel end
                
                RunService.Stepped:Wait()
                if root and root.Parent then 
                    root.Velocity = vel + Vector3.new(0, 0.1, 0) 
                end
            end
        end)
    else
        for _, c in ipairs(_wfConns) do
            if typeof(c) == "RBXScriptConnection" then c:Disconnect() end
        end
        _wfConns = {}
    end
end

--// Inf Jump Logic
local infinityJumpEnabled = Config.infinityJumpEnabled
local jumpForce = 50
local clampFallSpeed = 80
local isSpaceHeld = false

UIS.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.Space then
        isSpaceHeld = true
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space then
        isSpaceHeld = false
    end
end)

RunService.Heartbeat:Connect(function()
    if not infinityJumpEnabled then return end
    local char = LP.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if hrp.Velocity.Y < -clampFallSpeed then
        hrp.Velocity = Vector3.new(hrp.Velocity.X, -clampFallSpeed, hrp.Velocity.Z)
    end
    
    if isSpaceHeld then
        if hrp.Velocity.Y < jumpForce then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, jumpForce, hrp.Velocity.Z)
        end
    end
end)

--// Anti Ragdoll Logic
local antiRagdollMode = nil
local ragdollConnections = {}
local cachedCharData = {}
local isBoosting = false
local BOOST_SPEED = 400
local AR_DEFAULT_SPEED = 16

local function arCacheCharacterData()
    local char = LP.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end
    cachedCharData = { character = char, humanoid = hum, root = root }
    return true
end

local function arDisconnectAll()
    for _, conn in ipairs(ragdollConnections) do
        pcall(function() conn:Disconnect() end)
    end
    ragdollConnections = {}
end

local function arIsRagdolled()
    if not cachedCharData.humanoid then return false end
    local state = cachedCharData.humanoid:GetState()
    local ragdollStates = {
        [Enum.HumanoidStateType.Physics] = true,
        [Enum.HumanoidStateType.Ragdoll] = true,
        [Enum.HumanoidStateType.FallingDown] = true,
    }
    if ragdollStates[state] then return true end
    local endTime = LP:GetAttribute("RagdollEndTime")
    if endTime and (endTime - workspace:GetServerTimeNow()) > 0 then return true end
    return false
end

local function arForceExitRagdoll()
    if not cachedCharData.humanoid or not cachedCharData.root then return end
    pcall(function()
        LP:SetAttribute("RagdollEndTime", workspace:GetServerTimeNow())
    end)
    for _, descendant in ipairs(cachedCharData.character:GetDescendants()) do
        if descendant:IsA("BallSocketConstraint") or
           (descendant:IsA("Attachment") and descendant.Name:find("RagdollAttachment")) then
            descendant:Destroy()
        end
    end
    if not isBoosting then
        isBoosting = true
        cachedCharData.humanoid.WalkSpeed = BOOST_SPEED
    end
    if cachedCharData.humanoid.Health > 0 then
        cachedCharData.humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end
    cachedCharData.root.Anchored = false
end

local function arHeartbeatLoop()
    while antiRagdollMode == "v1" do
        task.wait()
        local currentlyRagdolled = arIsRagdolled()
        if currentlyRagdolled then
            arForceExitRagdoll()
        elseif isBoosting and not currentlyRagdolled then
            isBoosting = false
            if cachedCharData.humanoid then
                cachedCharData.humanoid.WalkSpeed = AR_DEFAULT_SPEED
            end
        end
    end
end

local function startAntiRagdoll()
    if antiRagdollMode == "v1" then return end
    if not arCacheCharacterData() then return end
    antiRagdollMode = "v1"

    local camConn = RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if cam and cachedCharData.humanoid then
            cam.CameraSubject = cachedCharData.humanoid
        end
    end)
    table.insert(ragdollConnections, camConn)

    local respawnConn = LP.CharacterAdded:Connect(function()
        isBoosting = false
        task.wait(0.5)
        arCacheCharacterData()
    end)
    table.insert(ragdollConnections, respawnConn)

    task.spawn(arHeartbeatLoop)
end

local function stopAntiRagdoll()
    antiRagdollMode = nil
    if isBoosting and cachedCharData.humanoid then
        cachedCharData.humanoid.WalkSpeed = AR_DEFAULT_SPEED
    end
    isBoosting = false
    arDisconnectAll()
    cachedCharData = {}
end

--// Auto Kick Logic
local autoKickStealOn = Config.autoKickEnabled
local autoKickSetup = false

local function setupAutoKick()
    if autoKickSetup then return end
    autoKickSetup = true
    
    local pg = LP:WaitForChild("PlayerGui")
    local function chk(t) 
        return typeof(t) == "string" and t:lower():find("you stole") 
    end
    local function kick() 
        if autoKickStealOn then 
            pcall(function() LP:Kick("You stole!") end) 
        end 
    end
    local function watch(gui)
        gui.DescendantAdded:Connect(function(d)
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                if chk(d.Text) then kick() end
                d:GetPropertyChangedSignal("Text"):Connect(function() 
                    if chk(d.Text) then kick() end 
                end)
            end
        end)
    end
    for _, g in ipairs(pg:GetChildren()) do 
        watch(g) 
    end
    pg.ChildAdded:Connect(function(g) 
        watch(g) 
    end)
end

--// INSTANT RESET LOGIC (extracted from Ace script)
local resetCooldown = false
local currentBindKey = Enum.KeyCode.F

local function getHRP()
    local char = LP.Character
    if char then
        return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso")
    end
    return nil
end

local function getHumanoid()
    local char = LP.Character
    if char then
        return char:FindFirstChildOfClass("Humanoid")
    end
    return nil
end

local function performReset()
    if resetCooldown then return end
    resetCooldown = true

    local char = LP.Character
    if not char then
        resetCooldown = false
        return
    end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = getHRP()
    
    if not hrp then
        resetCooldown = false
        return
    end

    -- Camera effect
    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraType = Enum.CameraType.Scriptable
        cam.CFrame = CFrame.new(-337.938599, -0.585044861, 106.739204, 0.133411571, -0.379638135, 0.915465117, 0, 0.923722506, 0.383062422, -0.991060734, -0.0511049591, 0.123235278)
        cam.Focus = CFrame.new(-349.381927, -5.37332535, 105.198761, 1, 0, 0, 0, 1, 0, 0, 0, 1)

        task.delay(0.1, function()
            if cam and hum then
                cam.CameraType = Enum.CameraType.Custom
                cam.CameraSubject = hum
            end
        end)
    end

    -- Break joints and launch
    if hum then
        hum.BreakJointsOnDeath = true
        hum.PlatformStand = true
        hum:ChangeState(Enum.HumanoidStateType.Physics)
    end

    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    hrp.AssemblyLinearVelocity = Vector3.new(0, 1000000, 0)

    task.delay(0.5, function()
        resetCooldown = false
    end)
end

--// Anti-Die Logic
local antiDieEnabled = Config.antiDieEnabled
local antiDieConnections = {}

local function disableAntiDie()
    for _, conn in ipairs(antiDieConnections) do
        pcall(function() conn:Disconnect() end)
    end
    antiDieConnections = {}
end

local function enableAntiDie()
    disableAntiDie()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local healthConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
        if hum.Health <= 0 then
            hum.Health = hum.MaxHealth
        end
    end)
    table.insert(antiDieConnections, healthConn)

    local diedConn = hum.Died:Connect(function()
        task.wait()  
        pcall(function()
            local newHum = Instance.new("Humanoid")
            newHum.Name = "Humanoid"
            newHum.Parent = char
            if Workspace.CurrentCamera then
                Workspace.CurrentCamera.CameraSubject = newHum
            end
            hum:Destroy()
        end)
    end)
    table.insert(antiDieConnections, diedConn)
end

--// Side Buttons UI
local sideGui = Instance.new("ScreenGui")
sideGui.Name = "SideButtonsGui"
sideGui.ResetOnSpawn = false
sideGui.Parent = LP:WaitForChild("PlayerGui")

local function createCleanButton(name, text, posY)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = sideGui
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    btn.BackgroundTransparency = 0.1
    btn.Position = UDim2.new(1, -150, 0.4, posY)
    btn.Size = UDim2.new(0, 130, 0, 38)
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.TextSize = 13
    btn.AutoButtonColor = false
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.8
    stroke.Thickness = 1
    stroke.Parent = btn
    
    return btn
end

local dropButton = createCleanButton("DropButton", "DROP", 0)
local infJumpButton = createCleanButton("InfJumpButton", "INF JUMP: OFF", 45)
local lockButton = createCleanButton("LockButton", "LOCK: OFF", 90)
local antiRagdollButton = createCleanButton("AntiRagdollButton", "ANTI RAGDOLL: OFF", 135)
local autoKickButton = createCleanButton("AutoKickButton", "AUTO KICK: OFF", 180)
local antiDieButton = createCleanButton("AntiDieButton", "ANTI DIE: OFF", 225)
local instantResetButton = createCleanButton("InstantResetButton", "INSTANT RESET", 270)

--// Button Connections
dropButton.MouseButton1Click:Connect(function()
    task.spawn(function()
        toggleDrop(true)
        task.wait(0.1)
        toggleDrop(false)
    end)
    dropButton.TextColor3 = Color3.fromRGB(60, 255, 60)
    task.delay(0.2, function()
        dropButton.TextColor3 = Color3.fromRGB(220, 220, 220)
    end)
end)

infJumpButton.MouseButton1Click:Connect(function()
    infinityJumpEnabled = not infinityJumpEnabled
    Config.infinityJumpEnabled = infinityJumpEnabled
    saveConfig()
    if infinityJumpEnabled then
        infJumpButton.Text = "INF JUMP: ON"
        infJumpButton.TextColor3 = Color3.fromRGB(60, 255, 60)
    else
        infJumpButton.Text = "INF JUMP: OFF"
        infJumpButton.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end)

local isLocked = Config.isLocked

lockButton.MouseButton1Click:Connect(function()
    isLocked = not isLocked
    Config.isLocked = isLocked
    saveConfig()
    if isLocked then
        lockButton.Text = "LOCK: ON"
        lockButton.TextColor3 = Color3.fromRGB(60, 255, 60)
    else
        lockButton.Text = "LOCK: OFF"
        lockButton.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end)

task.spawn(function()
    while task.wait() do
        pcall(function()
            if isLocked and LP.Character then
                local character = LP.Character
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Anchored = true
                    end
                end
            elseif not isLocked and LP.Character then
                local character = LP.Character
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Anchored = false
                    end
                end
            end
        end)
    end
end)

antiRagdollButton.MouseButton1Click:Connect(function()
    if antiRagdollMode == "v1" then
        stopAntiRagdoll()
        Config.antiRagdollEnabled = false
        antiRagdollButton.Text = "ANTI RAGDOLL: OFF"
        antiRagdollButton.TextColor3 = Color3.fromRGB(220, 220, 220)
    else
        startAntiRagdoll()
        if antiRagdollMode == "v1" then
            Config.antiRagdollEnabled = true
            antiRagdollButton.Text = "ANTI RAGDOLL: ON"
            antiRagdollButton.TextColor3 = Color3.fromRGB(60, 255, 60)
        end
    end
    saveConfig()
end)

autoKickButton.MouseButton1Click:Connect(function()
    autoKickStealOn = not autoKickStealOn
    Config.autoKickEnabled = autoKickStealOn
    saveConfig()
    if autoKickStealOn then
        autoKickButton.Text = "AUTO KICK: ON"
        autoKickButton.TextColor3 = Color3.fromRGB(60, 255, 60)
        setupAutoKick()
    else
        autoKickButton.Text = "AUTO KICK: OFF"
        autoKickButton.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end)

antiDieButton.MouseButton1Click:Connect(function()
    antiDieEnabled = not antiDieEnabled
    Config.antiDieEnabled = antiDieEnabled
    saveConfig()
    if antiDieEnabled then
        enableAntiDie()
        antiDieButton.Text = "ANTI DIE: ON"
        antiDieButton.TextColor3 = Color3.fromRGB(60, 255, 60)
    else
        disableAntiDie()
        antiDieButton.Text = "ANTI DIE: OFF"
        antiDieButton.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end)

-- Instant Reset Button - Left click to reset, Right click to change bind
instantResetButton.MouseButton1Click:Connect(function()
    performReset()
    instantResetButton.TextColor3 = Color3.fromRGB(60, 255, 60)
    task.delay(0.5, function()
        instantResetButton.TextColor3 = Color3.fromRGB(220, 220, 220)
    end)
end)

-- Right click to change keybind
local bindingMode = false
instantResetButton.MouseButton2Click:Connect(function()
    if bindingMode then return end
    bindingMode = true
    instantResetButton.Text = "PRESS A KEY"
    instantResetButton.TextColor3 = Color3.fromRGB(255, 255, 0)
    
    local conn
    conn = UIS.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            currentBindKey = input.KeyCode
            instantResetButton.Text = "INSTANT RESET"
            instantResetButton.TextColor3 = Color3.fromRGB(220, 220, 220)
            bindingMode = false
            conn:Disconnect()
        end
    end)
    
    task.delay(5, function()
        if conn and conn.Connected then
            conn:Disconnect()
            instantResetButton.Text = "INSTANT RESET"
            instantResetButton.TextColor3 = Color3.fromRGB(220, 220, 220)
            bindingMode = false
        end
    end)
end)

-- Keybind listener
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentBindKey then
        performReset()
    end
end)

--// Apply Config to UI on Load
if Config.infinityJumpEnabled then
    infJumpButton.Text = "INF JUMP: ON"
    infJumpButton.TextColor3 = Color3.fromRGB(60, 255, 60)
end

if Config.isLocked then
    lockButton.Text = "LOCK: ON"
    lockButton.TextColor3 = Color3.fromRGB(60, 255, 60)
end

if Config.antiRagdollEnabled then
    startAntiRagdoll()
    if antiRagdollMode == "v1" then
        antiRagdollButton.Text = "ANTI RAGDOLL: ON"
        antiRagdollButton.TextColor3 = Color3.fromRGB(60, 255, 60)
    end
end

if Config.autoKickEnabled then
    setupAutoKick()
    autoKickButton.Text = "AUTO KICK: ON"
    autoKickButton.TextColor3 = Color3.fromRGB(60, 255, 60)
end

if Config.antiDieEnabled then
    enableAntiDie()
    antiDieButton.Text = "ANTI DIE: ON"
    antiDieButton.TextColor3 = Color3.fromRGB(60, 255, 60)
end

--// Character Added Setup
LP.CharacterAdded:Connect(function()
    task.wait(0.5)
    if antiDieEnabled then
        enableAntiDie()
    end
end)

if LP.Character then
    if antiDieEnabled then
        enableAntiDie()
    end
end
