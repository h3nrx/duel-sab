-- Steal A Brainrot Helper
-- Simple UI - All Features Working

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

-- Settings
local Settings = {
    AutoKick = false,
    StealOnSpeed = false,
    StealNormal = false,
    ESPBestBrainrot = false,
    ESPNextBase = false,
    AntiRagdoll = false,
    AntiEffects = false,
    AutoGrabNearest = false
}

-- Speed Values
local SPEED_NORMAL = 59
local SPEED_ON_SPEED = 29

-- Variables
local speedBoosterConnection = nil
local bestESP = nil
local baseESP = nil

-- Helper Functions
local function getEnemyPlots()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return {} end
    local enemyPlots = {}
    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        local isMyBase = false
        if sign then
            local yourBase = sign:FindFirstChild("YourBase")
            if yourBase and yourBase.Enabled then
                isMyBase = true
            end
        end
        if not isMyBase then
            table.insert(enemyPlots, plot)
        end
    end
    return enemyPlots
end

local function getAllBrainrots()
    local brainrots = {}
    local enemyPlots = getEnemyPlots()
    
    for _, plot in ipairs(enemyPlots) do
        local podiums = plot:FindFirstChild("AnimalPodiums")
        if podiums then
            for _, podium in ipairs(podiums:GetChildren()) do
                local base = podium:FindFirstChild("Base")
                local spawn = base and base:FindFirstChild("Spawn")
                local att = spawn and spawn:FindFirstChild("PromptAttachment")
                local prompt = att and att:FindFirstChildWhichIsA("ProximityPrompt")
                
                if prompt and prompt.Enabled and prompt.ActionText == "Steal" then
                    local animalName = "Unknown"
                    local genValue = 0
                    local animalModel = nil
                    
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:IsDescendantOf(plot) then
                            local dist = (obj:GetPivot().Position - spawn.Position).Magnitude
                            if dist < 15 then
                                animalModel = obj
                                break
                            end
                        end
                    end
                    
                    if animalModel then
                        for _, d in ipairs(animalModel:GetDescendants()) do
                            if d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
                                for _, lbl in ipairs(d:GetDescendants()) do
                                    if lbl:IsA("TextLabel") and lbl.Name == "DisplayName" then
                                        animalName = lbl.Text
                                    elseif lbl:IsA("TextLabel") and lbl.Name == "Generation" then
                                        local genText = lbl.Text:gsub("[^%d.]", "")
                                        genValue = tonumber(genText) or 0
                                    end
                                end
                            end
                        end
                    end
                    
                    table.insert(brainrots, {
                        prompt = prompt,
                        position = spawn.Position,
                        name = animalName,
                        genValue = genValue,
                        animalModel = animalModel
                    })
                end
            end
        end
    end
    
    table.sort(brainrots, function(a, b) return a.genValue > b.genValue end)
    return brainrots
end

local function getNearestBrainrot()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local brainrots = getAllBrainrots()
    local nearest = nil
    local nearestDist = math.huge
    
    for _, br in ipairs(brainrots) do
        local dist = (br.position - hrp.Position).Magnitude
        if dist < nearestDist then
            nearestDist = dist
            nearest = br
        end
    end
    return nearest, nearestDist
end

local function getBestBrainrot()
    local brainrots = getAllBrainrots()
    if #brainrots > 0 then
        return brainrots[1]
    end
    return nil
end

local function setSpeed(speedValue)
    if speedBoosterConnection then
        speedBoosterConnection:Disconnect()
        speedBoosterConnection = nil
    end
    
    if speedValue then
        speedBoosterConnection = RunService.Heartbeat:Connect(function()
            if not (Settings.StealNormal or Settings.StealOnSpeed) then return end
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum then
                local moveDir = hum.MoveDirection
                if moveDir.Magnitude > 0 then
                    local flatDir = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
                    hrp.Velocity = Vector3.new(flatDir.X * speedValue, hrp.Velocity.Y, flatDir.Z * speedValue)
                end
            end
        end)
    end
end

local function stealBrainrot(prompt)
    if not prompt or not prompt.Parent then return false end
    
    local success = false
    if fireproximityprompt then
        success = pcall(fireproximityprompt, prompt)
    end
    
    if not success then
        pcall(function()
            prompt:InputBegan(Enum.UserInputType.MouseButton1, false)
            task.wait(prompt.HoldDuration or 1.3)
            prompt:InputEnded(Enum.UserInputType.MouseButton1, false)
        end)
        success = true
    end
    
    return success
end

-- Auto Grab Loop
task.spawn(function()
    while true do
        if Settings.AutoGrabNearest then
            local nearest = getNearestBrainrot()
            if nearest and nearest.prompt then
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - nearest.position).Magnitude <= 30 then
                    stealBrainrot(nearest.prompt)
                    task.wait(1.5)
                end
            end
        end
        task.wait(0.3)
    end
end)

-- Steal Normal Loop
task.spawn(function()
    while true do
        if Settings.StealNormal then
            setSpeed(SPEED_NORMAL)
            local best = getBestBrainrot()
            if best and best.prompt then
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - best.position).Magnitude <= 30 then
                    stealBrainrot(best.prompt)
                    task.wait(1.5)
                end
            end
        elseif not Settings.StealOnSpeed then
            setSpeed(nil)
        end
        task.wait(0.3)
    end
end)

-- Steal On Speed Loop
task.spawn(function()
    while true do
        if Settings.StealOnSpeed then
            setSpeed(SPEED_ON_SPEED)
            local best = getBestBrainrot()
            if best and best.prompt then
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - best.position).Magnitude <= 30 then
                    stealBrainrot(best.prompt)
                    task.wait(1.5)
                end
            end
        elseif not Settings.StealNormal then
            setSpeed(nil)
        end
        task.wait(0.3)
    end
end)

-- Auto Kick
task.spawn(function()
    local lastKickTime = 0
    while true do
        if Settings.AutoKick then
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            if pg then
                for _, obj in ipairs(pg:GetDescendants()) do
                    if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Text then
                        local text = obj.Text:lower()
                        if text:find("you stole") and tick() - lastKickTime > 2 then
                            lastKickTime = tick()
                            task.spawn(function()
                                pcall(function() LocalPlayer:Kick("Auto Kick - Steal detected") end)
                                pcall(function() game:Shutdown() end)
                            end)
                        end
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

-- Anti Ragdoll
task.spawn(function()
    while true do
        if Settings.AntiRagdoll then
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                
                if hum then
                    local state = hum:GetState()
                    if state == Enum.HumanoidStateType.Physics or 
                       state == Enum.HumanoidStateType.Ragdoll or
                       state == Enum.HumanoidStateType.FallingDown then
                        if hum.Health > 0 then
                            hum:ChangeState(Enum.HumanoidStateType.Running)
                        end
                        if hrp then
                            hrp.Velocity = Vector3.zero
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

-- Anti Effects
local function removeEffects()
    if not Settings.AntiEffects then return end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or 
           obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            pcall(function() obj.Enabled = false end)
        end
    end
    
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("BloomEffect") or effect:IsA("BlurEffect") or
           effect:IsA("SunRaysEffect") or effect:IsA("ColorCorrectionEffect") then
            pcall(function() effect.Enabled = false end)
        end
    end
    
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 1e9
end

removeEffects()

workspace.DescendantAdded:Connect(function(obj)
    if Settings.AntiEffects then
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or
           obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            pcall(function() obj.Enabled = false end)
        end
    end
end)

-- ESP Best Brainrot
task.spawn(function()
    while true do
        if Settings.ESPBestBrainrot then
            local best = getBestBrainrot()
            if best and best.animalModel then
                if not bestESP or not bestESP.Parent then
                    if bestESP then bestESP:Destroy() end
                    bestESP = Instance.new("Highlight")
                    bestESP.FillColor = Color3.fromRGB(255, 0, 0)
                    bestESP.FillTransparency = 0.5
                    bestESP.OutlineColor = Color3.fromRGB(255, 255, 255)
                    bestESP.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                end
                bestESP.Adornee = best.animalModel
                bestESP.Parent = best.animalModel
            elseif bestESP then
                bestESP:Destroy()
                bestESP = nil
            end
        elseif bestESP then
            bestESP:Destroy()
            bestESP = nil
        end
        task.wait(0.5)
    end
end)

-- ESP Next Base
task.spawn(function()
    local function findNextBaseSpawn()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil end
        
        local myOrder = nil
        for _, plot in ipairs(plots:GetChildren()) do
            local sign = plot:FindFirstChild("PlotSign")
            if sign then
                local yourBase = sign:FindFirstChild("YourBase")
                if yourBase and yourBase.Enabled then
                    myOrder = plot:GetAttribute("Order")
                    break
                end
            end
        end
        
        if myOrder == 1 then
            return Vector3.new(-337, -5, 103)
        elseif myOrder == 2 then
            return Vector3.new(-334.80, -5.04, 18.90)
        end
        return nil
    end
    
    while true do
        if Settings.ESPNexBase then
            local spawnPos = findNextBaseSpawn()
            if spawnPos then
                if not baseESP then
                    baseESP = Instance.new("Part")
                    baseESP.Name = "NextBase"
                    baseESP.Size = Vector3.new(8, 0.5, 8)
                    baseESP.Anchored = true
                    baseESP.CanCollide = false
                    baseESP.Transparency = 0.5
                    baseESP.BrickColor = BrickColor.new("Bright green")
                    baseESP.Material = Enum.Material.Neon
                    baseESP.Parent = workspace
                end
                baseESP.CFrame = CFrame.new(spawnPos)
            elseif baseESP then
                baseESP:Destroy()
                baseESP = nil
            end
        elseif baseESP then
            baseESP:Destroy()
            baseESP = nil
        end
        task.wait(0.5)
    end
end)

-- Instant Reset
local function instantReset()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Health = 0
    end
end

-- ========== SIMPLE UI ==========
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BrainrotHelper"
screenGui.ResetOnSpawn = false
pcall(function() screenGui.Parent = game:GetService("CoreGui") end)
if not screenGui.Parent then
    screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 200, 0, 310)
mainFrame.Position = UDim2.new(0.5, -100, 0.5, -155)
mainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
mainFrame.BackgroundTransparency = 0.15
mainFrame.BorderSizePixel = 1
mainFrame.BorderColor3 = Color3.fromRGB(60, 60, 70)
mainFrame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = mainFrame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.Position = UDim2.new(0, 0, 0, 0)
title.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
title.Text = "Brainrot Helper"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 13
title.Font = Enum.Font.GothamBold
title.Parent = mainFrame
local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0, 8)
titleCorner.Parent = title

local scrollFrame = Instance.new("ScrollingFrame")
scrollFrame.Size = UDim2.new(1, -10, 1, -70)
scrollFrame.Position = UDim2.new(0, 5, 0, 35)
scrollFrame.BackgroundTransparency = 1
scrollFrame.BorderSizePixel = 0
scrollFrame.ScrollBarThickness = 3
scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
scrollFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
scrollFrame.Parent = mainFrame

local scrollLayout = Instance.new("UIListLayout")
scrollLayout.Padding = UDim.new(0, 5)
scrollLayout.SortOrder = Enum.SortOrder.LayoutOrder
scrollLayout.Parent = scrollFrame

local function createToggle(parent, text, settingName)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -5, 0, 28)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    frame.BackgroundTransparency = 0.4
    frame.BorderSizePixel = 0
    frame.Parent = parent
    
    local frameCorner = Instance.new("UICorner")
    frameCorner.CornerRadius = UDim.new(0, 4)
    frameCorner.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -50, 1, 0)
    label.Position = UDim2.new(0, 8, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextSize = 11
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    
    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 32, 0, 16)
    track.Position = UDim2.new(1, -38, 0.5, -8)
    track.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    track.BorderSizePixel = 0
    track.Parent = frame
    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track
    
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = UDim2.new(0, 2, 0.5, -6)
    knob.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
    knob.BorderSizePixel = 0
    knob.Parent = track
    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob
    
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 1, 0)
    button.BackgroundTransparency = 1
    button.Text = ""
    button.Parent = frame
    
    button.MouseButton1Click:Connect(function()
        Settings[settingName] = not Settings[settingName]
        if Settings[settingName] then
            TweenService:Create(knob, TweenInfo.new(0.1), {Position = UDim2.new(1, -14, 0.5, -6)}):Play()
            TweenService:Create(track, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(80, 160, 80)}):Play()
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        else
            TweenService:Create(knob, TweenInfo.new(0.1), {Position = UDim2.new(0, 2, 0.5, -6)}):Play()
            TweenService:Create(track, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50, 50, 55)}):Play()
            knob.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
            
            if settingName == "StealNormal" then
                setSpeed(nil)
            elseif settingName == "StealOnSpeed" then
                setSpeed(nil)
            end
        end
    end)
    
    return frame
end

createToggle(scrollFrame, "Auto Grab Nearest", "AutoGrabNearest")
createToggle(scrollFrame, "Steal Normal (59 Speed)", "StealNormal")
createToggle(scrollFrame, "Steal on Speed (29 Speed)", "StealOnSpeed")
createToggle(scrollFrame, "ESP Best Brainrot", "ESPBestBrainrot")
createToggle(scrollFrame, "ESP Next Base", "ESPNexBase")
createToggle(scrollFrame, "Anti Ragdoll", "AntiRagdoll")
createToggle(scrollFrame, "Anti Effects", "AntiEffects")
createToggle(scrollFrame, "Auto Kick on Steal", "AutoKick")

local resetBtn = Instance.new("TextButton")
resetBtn.Size = UDim2.new(1, -10, 0, 30)
resetBtn.Position = UDim2.new(0, 5, 1, -35)
resetBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
resetBtn.Text = "Instant Reset"
resetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
resetBtn.TextSize = 11
resetBtn.Font = Enum.Font.GothamBold
resetBtn.Parent = mainFrame
local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 4)
btnCorner.Parent = resetBtn

resetBtn.MouseButton1Click:Connect(function()
    instantReset()
end)

resetBtn.MouseEnter:Connect(function()
    TweenService:Create(resetBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(60, 60, 70)}):Play()
end)
resetBtn.MouseLeave:Connect(function()
    TweenService:Create(resetBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(45, 45, 55)}):Play()
end)

local footer = Instance.new("TextLabel")
footer.Size = UDim2.new(1, 0, 0, 18)
footer.Position = UDim2.new(0, 0, 1, -18)
footer.BackgroundTransparency = 1
footer.Text = "v1.0 | 59/29 Speed"
