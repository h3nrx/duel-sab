local Toggle_ESPNextBase      = CreateToggle("ESPNextBase", "ESP Next Base", 5)
local Toggle_AntiRagdoll      = CreateToggle("AntiRagdoll", "Anti Ragdoll", 6)
local Toggle_AutoGrabNearest  = CreateToggle("AutoGrabNearest", "Auto Grab Nearest", 7)
local Toggle_AntiEffects      = CreateToggle("AntiEffects", "Anti Effects", 8)
local Button_InstantReset     = CreateButton("InstantReset", "Instant Reset", 9)

