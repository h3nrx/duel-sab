--[[
    Steal A Brainrot Helper
    Features: Auto Kick, Steal on Speed (29), Steal Normal (59), ESP Best Brainrot,
    ESP next Base, Anti Ragdoll, Instant Reset, Auto Grab Nearest, Anti Effects
    Core GUI - Undetected
    MIT getconnections() Support - Fallback wenn nicht verfügbar
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

-- ========== CHECK GETCONNECTIONS ==========
local hasGetConnections = pcall(getconnections, game)
local useFallbackSteal = not hasGetConnections

if not hasGetConnections then
    warn("[Brainrot Helper] getconnections() nicht verfügbar - Verwende Fallback Methode für Steals")
end

-- ========== SETTINGS ==========
local Settings = {
    AutoKick = false,
    StealOnSpeed = false,
    StealNormal = false,
    ESPBestBrainrot = false,
    ESPNextBase = false,
    AntiRagdoll = false,
    AntiEffects = false,
    AutoGrabNearest = false
}

-- ========== SPEED VALUES ==========
local SPEED_NORMAL = 59
local SPEED_ON_SPEED = 29

-- ========== VARIABLES ==========
local speedBoosterConnection = nil
local autoGrabRunning = false
local stealNormalRunning = false
local stealOnSpeedRunning = false

-- ========== HELPER FUNCTIONS ==========

-- Find all enemy plots
local function getEnemyPlots()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return {} end
    local enemyPlots = {}
    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        local isMyBase = false
        if sign then
            local yourBase = sign:FindFirstChild("YourBase")
            if yourBase and yourBase.Enabled then
                isMyBase = true
            end
        end
        if not isMyBase then
            table.insert(enemyPlots, plot)
        end
    end
    return enemyPlots
end

-- Get all brainrots
local function getAllBrainrots()
    local brainrots = {}
    local enemyPlots = getEnemyPlots()
    
    for _, plot in ipairs(enemyPlots) do
        local podiums = plot:FindFirstChild("AnimalPodiums")
        if podiums then
            for _, podium in ipairs(podiums:GetChildren()) do
                local base = podium:FindFirstChild("Base")
                local spawn = base and base:FindFirstChild("Spawn")
                local att = spawn and spawn:FindFirstChild("PromptAttachment")
                local prompt = att and att:FindFirstChildWhichIsA("ProximityPrompt")
                
                if prompt and prompt.Enabled and prompt.ActionText == "Steal" then
                    local animalName = "Unknown"
                    local genValue = 0
                    local animalModel = nil
                    
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:IsDescendantOf(plot) then
                            local dist = (obj:GetPivot().Position - spawn.Position).Magnitude
                            if dist < 15 then
                                animalModel = obj
                                break
                            end
                        end
                    end
                    
                    if animalModel then
                        for _, d in ipairs(animalModel:GetDescendants()) do
                            if d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
                                for _, lbl in ipairs(d:GetDescendants()) do
                                    if lbl:IsA("TextLabel") and lbl.Name == "DisplayName" then
                                        animalName = lbl.Text
                                    elseif lbl:IsA("TextLabel") and lbl.Name == "Generation" then
                                        local genText = lbl.Text:gsub("[^%d.]", "")
                                        genValue = tonumber(genText) or 0
                                    end
                                end
                            end
                        end
                    end
                    
                    table.insert(brainrots, {
                        prompt = prompt,
                        position = spawn.Position,
                        name = animalName,
                        genValue = genValue,
                        plot = plot,
                        animalModel = animalModel
                    })
                end
            end
        end
    end
    
    table.sort(brainrots, function(a, b) return a.genValue > b.genValue end)
    return brainrots
end

-- Get nearest brainrot
local function getNearestBrainrot()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local brainrots = getAllBrainrots()
    local nearest = nil
    local nearestDist = math.huge
    
    for _, br in ipairs(brainrots) do
        local dist = (br.position - hrp.Position).Magnitude
        if dist < nearestDist then
            nearestDist = dist
            nearest = br
        end
    end
    return nearest, nearestDist
end

-- Get best brainrot
local function getBestBrainrot()
    local brainrots = getAllBrainrots()
    if #brainrots > 0 then
        return brainrots[1]
    end
    return nil
end

-- Speed booster
local function setSpeed(speedValue)
    if speedBoosterConnection then
        speedBoosterConnection:Disconnect()
        speedBoosterConnection = nil
    end
    
    if speedValue then
        speedBoosterConnection = RunService.Heartbeat:Connect(function()
            if not (Settings.StealNormal or Settings.StealOnSpeed) then return end
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum then
                local moveDir = hum.MoveDirection
                if moveDir.Magnitude > 0 then
                    local flatDir = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
                    hrp.Velocity = Vector3.new(flatDir.X * speedValue, hrp.Velocity.Y, flatDir.Z * speedValue)
                end
            end
        end)
    end
end

-- ========== STEAL FUNCTION (MIT FALLBACK) ==========
local function stealBrainrot(prompt)
    if not prompt or not prompt.Parent then return false end
    
    local success = false
    
    if not useFallbackSteal and hasGetConnections then
        -- === METHODE 1: Mit getconnections() ===
        local holdCallbacks = {}
        local triggerCallbacks = {}
        
        local ok1, conns1 = pcall(getconnections, prompt.PromptButtonHoldBegan)
        if ok1 then
            for _, conn in ipairs(conns1) do
                if type(conn.Function) == "function" then
                    table.insert(holdCallbacks, conn.Function)
                end
            end
        end
        
        local ok2, conns2 = pcall(getconnections, prompt.Triggered)
        if ok2 then
            for _, conn in ipairs(conns2) do
                if type(conn.Function) == "function" then
                    table.insert(triggerCallbacks, conn.Function)
                end
            end
        end
        
        if #holdCallbacks > 0 or #triggerCallbacks > 0 then
            for _, fn in ipairs(holdCallbacks) do
                task.spawn(fn)
            end
            
            local holdDuration = prompt.HoldDuration
            if holdDuration < 1 then holdDuration = 1.3 end
            task.wait(holdDuration - 0.1)
            
            for _, fn in ipairs(triggerCallbacks) do
                task.spawn(fn)
            end
            success = true
        end
    end
    
    -- === METHODE 2: Fallback (wenn getconnections nicht verfügbar oder fehlgeschlagen) ===
    if not success then
        if fireproximityprompt then
            success = pcall(fireproximityprompt, prompt)
        end
        
        if not success then
            pcall(function()
                prompt:InputBegan(Enum.UserInputType.MouseButton1, false)
                task.wait(1.3)
                prompt:InputEnded(Enum.UserInputType.MouseButton1, false)
            end)
            success = true
        end
    end
    
    return success
end

-- ========== AUTO GRAB NEAREST ==========
task.spawn(function()
    while true do
        if Settings.AutoGrabNearest and not autoGrabRunning then
            autoGrabRunning = true
            while Settings.AutoGrabNearest do
                local nearest = getNearestBrainrot()
                if nearest and nearest.prompt then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and (hrp.Position - nearest.position).Magnitude <= 30 then
                        stealBrainrot(nearest.prompt)
                        task.wait(1.5)
                    end
                end
                task.wait(0.3)
            end
            autoGrabRunning = false
        end
        task.wait(0.5)
    end
end)

-- ========== STEAL NORMAL (59 Speed) ==========
task.spawn(function()
    while true do
        if Settings.StealNormal and not stealNormalRunning then
            stealNormalRunning = true
            setSpeed(SPEED_NORMAL)
            while Settings.StealNormal do
                local best = getBestBrainrot()
                if best and best.prompt then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and (hrp.Position - best.position).Magnitude <= 30 then
                        stealBrainrot(best.prompt)
                        task.wait(1.5)
                    end
                end
                task.wait(0.3)
            end
            if not Settings.StealOnSpeed then
                setSpeed(nil)
            end
            stealNormalRunning = false
        end
        task.wait(0.5)
    end
end)

-- ========== STEAL ON SPEED (29 Speed) ==========
task.spawn(function()
    while true do
        if Settings.StealOnSpeed and not stealOnSpeedRunning then
            stealOnSpeedRunning = true
            setSpeed(SPEED_ON_SPEED)
            while Settings.StealOnSpeed do
                local best = getBestBrainrot()
                if best and best.prompt then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and (hrp.Position - best.position).Magnitude <= 30 then
                        stealBrainrot(best.prompt)
                        task.wait(1.5)
                    end
                end
                task.wait(0.3)
            end
            if not Settings.StealNormal then
                setSpeed(nil)
            end
            stealOnSpeedRunning = false
        end
        task.wait(0.5)
    end
end)

-- ========== AUTO KICK ON STEAL ==========
task.spawn(function()
    local lastKickTime = 0
    while true do
        if Settings.AutoKick then
            local chat = LocalPlayer:FindFirstChild("PlayerGui")
            if chat then
                local textLabels = chat:GetDescendants()
                for _, obj in ipairs(textLabels) do
                    if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Text then
                        local text = obj.Text:lower()
                        if text:find("you stole") and tick() - lastKickTime > 2 then
                            lastKickTime = tick()
                            task.spawn(function()
                                pcall(function() LocalPlayer:Kick("Auto Kick - Steal detected") end)
                                pcall(function() game:Shutdown() end)
                            end)
                        end
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

-- ========== ANTI RAGDOLL ==========
task.spawn(function()
    while true do
        if Settings.AntiRagdoll then
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                
                if hum then
                    local state = hum:GetState()
                    if state == Enum.HumanoidStateType.Physics or 
                       state == Enum.HumanoidStateType.Ragdoll or
                       state == Enum.HumanoidStateType.FallingDown then
                        if hum.Health > 0 then
                            hum:ChangeState(Enum.HumanoidStateType.Running)
                        end
                        if hrp then
                            hrp.Velocity = Vector3.zero
                            hrp.Anchored = false
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

-- ========== ANTI EFFECTS ==========
local function removeEffects()
    if not Settings.AntiEffects then return end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or 
           obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            pcall(function() obj.Enabled = false end)
        end
    end
    
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("BloomEffect") or effect:IsA("BlurEffect") or
           effect:IsA("SunRaysEffect") or effect:IsA("ColorCorrectionEffect") then
            pcall(function() effect.Enabled = false end)
        end
    end
    
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 1e9
end

-- Initial anti effects
removeEffects()

workspace.DescendantAdded:Connect(function(obj)
    if Settings.AntiEffects then
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or
           obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            pcall(function() obj.Enabled = false end)
        end
    end
end)

-- ========== ESP BEST BRAINROT ==========
local bestESP = nil
task.spawn(function()
    while true do
        if Settings.ESPBestBrainrot then
            local best = getBestBrainrot()
            if best and best.animalModel then
                if not bestESP or not bestESP.Parent then
                    if bestESP then bestESP:Destroy() end
                    bestESP = Instance.new("Highlight")
                    bestESP.FillColor = Color3.fromRGB(255, 0, 0)
                    bestESP.FillTransparency = 0.5
                    bestESP.OutlineColor = Color3.fromRGB(255, 255, 255)
                    bestESP.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                end
                bestESP.Adornee = best.animalModel
                bestESP.Parent = best.animalModel
            elseif bestESP then
                bestESP:Destroy()
                bestESP = nil
            end
        elseif bestESP then
            bestESP:Destroy()
            bestESP = nil
        end
        task.wait(0.5)
    end
end)

-- ========== ESP NEXT BASE ==========
local baseESP = nil
task.spawn(function()
    local function findNextBaseSpawn()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil end
        
        local myOrder = nil
        for _, plot in ipairs(plots:GetChildren()) do
            local sign = plot:FindFirstChild("PlotSign")
            if sign then
                local yourBase = sign:FindFirstChild("YourBase")
                if yourBase and yourBase.Enabled then
                    myOrder = plot:GetAttribute("Order")
                    break
                end
            end
        end
        
        if myOrder == 1 then
            return Vector3.new(-337, -5, 103)
        elseif myOrder == 2 then
            return Vector3.new(-334.80, -5.04, 18.90)
        end
        return nil
    end
    
    while true do
        if Settings.ESPNexBase then
            local spawnPos = findNextBaseSpawn()
            if spawnPos then
                if not baseESP then
                    baseESP = Instance.new("Part")
                    baseESP.Name = "NextBaseESP"
                    baseESP.Size = Vector3.new(8, 0.5, 8)
                    baseESP.Anchored = true
                    baseESP.CanCollide = false
                    baseESP.Transparency = 0.5
                    baseESP.BrickColor = BrickColor.new("Bright green")
                    baseESP.Material = Enum.Material.Neon
                    baseESP.Parent = workspace
                    
                    local billboard = Instance.new("BillboardGui")
                    billboard.Adornee = baseESP
                    billboard.Size = UDim2.new(0, 200, 0, 30)
                    billboard.StudsOffset = Vector3.new(0, 2, 0)
                    billboard.Parent = baseESP
                    
                    local label = Instance.new("TextLabel")
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.Text = "⬇️ NEXT BASE ⬇️"
                    label.TextColor3 = Color3.fromRGB(0, 255, 0)
                    label.TextSize = 14
                    label.Font = Enum.Font.GothamBold
                    label.TextStrokeTransparency = 0
                    label.TextStrokeColor3 = Color3.new(0, 0, 0)
                    label.Parent = billboard
                end
                baseESP.CFrame = CFrame.new(spawnPos)
            elseif baseESP then
                baseESP:Destroy()
                baseESP = nil
            end
        elseif baseESP then
            baseESP:Destroy()
            baseESP = nil
        end
        task.wait(0.5)
    end
end)

-- ========== INSTANT RESET ==========
local function instantReset()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Health = 0
    end
end

