--[[
    Steal A Brainrot Helper
    Features: Auto Kick, Steal on Speed (59), Steal Normal, ESP Best Brainrot,
    ESP next Base, Anti Ragdoll, Instant Reset, Auto Grab Nearest, Anti Effects
    Core GUI - Undetected
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

-- ========== SETTINGS ==========
local Settings = {
    AutoKick = false,
    StealOnSpeed = false,
    StealNormal = false,
    ESPBestBrainrot = false,
    ESPNextBase = false,
    AntiRagdoll = false,
    AntiEffects = false,
    AutoGrabNearest = false
}

-- ========== VARIABLES ==========
local brainrotList = {}
local espObjects = {}
local nextBasePosition = nil
local autoGrabActive = false
local speedBoosterActive = false
local speedValue = 59  -- Speed für Steal on Speed
local lastStealTime = 0
local currentStealMethod = "normal" -- "normal" oder "speed"

-- ========== HELPER FUNCTIONS ==========

-- Find all enemy plots
local function getEnemyPlots()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return {} end
    local enemyPlots = {}
    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        local isMyBase = false
        if sign then
            local yourBase = sign:FindFirstChild("YourBase")
            if yourBase and yourBase.Enabled then
                isMyBase = true
            end
        end
        if not isMyBase then
            table.insert(enemyPlots, plot)
        end
    end
    return enemyPlots
end

-- Get all brainrots from all plots
local function getAllBrainrots()
    local brainrots = {}
    local enemyPlots = getEnemyPlots()
    
    for _, plot in ipairs(enemyPlots) do
        local podiums = plot:FindFirstChild("AnimalPodiums")
        if podiums then
            for _, podium in ipairs(podiums:GetChildren()) do
                local base = podium:FindFirstChild("Base")
                local spawn = base and base:FindFirstChild("Spawn")
                local att = spawn and spawn:FindFirstChild("PromptAttachment")
                local prompt = att and att:FindFirstChildWhichIsA("ProximityPrompt")
                
                if prompt and prompt.Enabled and prompt.ActionText == "Steal" then
                    local animalName = "Unknown"
                    local genValue = 0
                    local animalModel = nil
                    
                    -- Find animal model near podium
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:IsDescendantOf(plot) then
                            local dist = (obj:GetPivot().Position - spawn.Position).Magnitude
                            if dist < 15 then
                                animalModel = obj
                                break
                            end
                        end
                    end
                    
                    -- Get display name and generation from model
                    if animalModel then
                        for _, d in ipairs(animalModel:GetDescendants()) do
                            if d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
                                for _, lbl in ipairs(d:GetDescendants()) do
                                    if lbl:IsA("TextLabel") and lbl.Name == "DisplayName" then
                                        animalName = lbl.Text
                                    elseif lbl:IsA("TextLabel") and lbl.Name == "Generation" then
                                        local genText = lbl.Text:gsub("[^%d.]", "")
                                        genValue = tonumber(genText) or 0
                                    end
                                end
                            end
                        end
                    end
                    
                    table.insert(brainrots, {
                        prompt = prompt,
                        position = spawn.Position,
                        name = animalName,
                        genValue = genValue,
                        plot = plot,
                        podium = podium,
                        animalModel = animalModel
                    })
                end
            end
        end
    end
    
    -- Sort by gen value for best ESP
    table.sort(brainrots, function(a, b) return a.genValue > b.genValue end)
    return brainrots
end

-- Get nearest brainrot
local function getNearestBrainrot()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local brainrots = getAllBrainrots()
    local nearest = nil
    local nearestDist = math.huge
    
    for _, br in ipairs(brainrots) do
        local dist = (br.position - hrp.Position).Magnitude
        if dist < nearestDist then
            nearestDist = dist
            nearest = br
        end
    end
    return nearest, nearestDist
end

-- Get best brainrot (highest gen)
local function getBestBrainrot()
    local brainrots = getAllBrainrots()
    if #brainrots > 0 then
        return brainrots[1]
    end
    return nil
end

-- Speed booster (für Steal on Speed)
local speedBoosterConnection = nil
local function startSpeedBooster()
    if speedBoosterConnection then
        speedBoosterConnection:Disconnect()
        speedBoosterConnection = nil
    end
    
    speedBoosterConnection = RunService.Heartbeat:Connect(function()
        if not Settings.StealOnSpeed then return end
        
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if hrp and hum then
            local moveDir = hum.MoveDirection
            if moveDir.Magnitude > 0 then
                local flatDir = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
                hrp.Velocity = Vector3.new(flatDir.X * speedValue, hrp.Velocity.Y, flatDir.Z * speedValue)
            end
        end
    end)
end

local function stopSpeedBooster()
    if speedBoosterConnection then
        speedBoosterConnection:Disconnect()
        speedBoosterConnection = nil
    end
end

