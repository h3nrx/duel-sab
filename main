-- Create toggle function
local function createToggle(parent, text, settingName)
    local toggleFrame = Instance.new("Frame")
    toggleFrame.Size = UDim2.new(1, -10, 0, 32)
    toggleFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    toggleFrame.BackgroundTransparency = 0.5
    toggleFrame.BorderSizePixel = 0
    toggleFrame.Parent = parent
    
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(0, 6)
    toggleCorner.Parent = toggleFrame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -50, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = toggleFrame
    
    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 36, 0, 18)
    track.Position = UDim2.new(1, -46, 0.5, -9)
    track.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    track.BorderSizePixel = 0
    track.Parent = toggleFrame
    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track
    
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    knob.BorderSizePixel = 0
    knob.Parent = track
    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob
    
    local function updateToggle(state)
        Settings[settingName] = state
        if state then
            TweenService:Create(knob, TweenInfo.new(0.1), {Position = UDim2.new(1, -16, 0.5, -7)}):Play()
            TweenService:Create(track, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(80, 180, 80)}):Play()
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        else
            TweenService:Create(knob, TweenInfo.new(0.1), {Position = UDim2.new(0, 2, 0.5, -7)}):Play()
            TweenService:Create(track, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50, 50, 55)}):Play()
            knob.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
            
            if settingName == "StealNormal" and not Settings.StealOnSpeed then
                setSpeed(nil)
            elseif settingName == "StealOnSpeed" and not Settings.StealNormal then
                setSpeed(nil)
            end
        end
    end
    
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 1, 0)
    button.BackgroundTransparency = 1
    button.Text = ""
    button.Parent = toggleFrame
    
    button.MouseButton1Click:Connect(function()
        if settingName == "StealNormal" and not Settings[settingName] then
            if Settings.StealOnSpeed then
                for _, child in ipairs(scrollFrame:GetChildren()) do
                    if child:IsA("Frame") and child:FindFirstChildWhichIsA("TextLabel") then
                        local lbl = child:FindFirstChildWhichIsA("TextLabel")
                        if lbl and lbl.Text:find("Steal on Speed") then
                            local otherTrack = child:FindFirstChildWhichIsA("Frame")
                            local otherKnob = otherTrack and otherTrack:FindFirstChildWhichIsA("Frame")
                            if otherTrack and otherKnob then
                                TweenService:Create(otherKnob, TweenInfo.new(0.1), {Position = UDim2.new(0, 2, 0.5, -7)}):Play()
                                TweenService:Create(otherTrack, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50, 50, 55)}):Play()
                                otherKnob.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
                            end
                            break
                        end
                    end
                end
                Settings.StealOnSpeed = false
            end
        elseif settingName == "StealOnSpeed" and not Settings[settingName] then
            if Settings.StealNormal then
                for _, child in ipairs(scrollFrame:GetChildren()) do
                    if child:IsA("Frame") and child:FindFirstChildWhichIsA("TextLabel") then
                        local lbl = child:FindFirstChildWhichIsA("TextLabel")
                        if lbl and lbl.Text:find("Steal Normal") then
                            local otherTrack = child:FindFirstChildWhichIsA("Frame")
                            local otherKnob = otherTrack and otherTrack:FindFirstChildWhichIsA("Frame")
                            if otherTrack and otherKnob then
                                TweenService:Create(otherKnob, TweenInfo.new(0.1), {Position = UDim2.new(0, 2, 0.5, -7)}):Play()
                                TweenService:Create(otherTrack, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50, 50, 55)}):Play()
                                otherKnob.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
                            end
                            break
                        end
                    end
                end
                Settings.StealNormal = false
            end
        end
        updateToggle(not Settings[settingName])
    end)
    
    return toggleFrame
end

-- Create all toggles
local toggleList = {
    {"🚀 Auto Grab Nearest", "AutoGrabNearest"},
    {"⚡ Steal Normal (59 Speed)", "StealNormal"},
    {"🐢 Steal on Speed (29 Speed)", "StealOnSpeed"},
    {"👁️ ESP Best Brainrot", "ESPBestBrainrot"},
    {"📍 ESP Next Base", "ESPNexBase"},
    {"🛡️ Anti Ragdoll", "AntiRagdoll"},
    {"🌀 Anti Effects", "AntiEffects"},
    {"💀 Auto Kick on Steal", "AutoKick"}
}

for _, toggle in ipairs(toggleList) do
    createToggle(scrollFrame, toggle[1], toggle[2])
end

-- Instant Reset Button
local resetBtn = Instance.new("TextButton")
resetBtn.Size = UDim2.new(1, -10, 0, 35)
resetBtn.Position = UDim2.new(0, 5, 1, -40)
resetBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
resetBtn.Text = "💀 INSTANT RESET 💀"
resetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
resetBtn.TextSize = 13
resetBtn.Font = Enum.Font.GothamBold
resetBtn.Parent = mainFrame

local resetCorner = Instance.new("UICorner")
resetCorner.CornerRadius = UDim.new(0, 6)
resetCorner.Parent = resetBtn

resetBtn.MouseButton1Click:Connect(function()
    instantReset()
end)

resetBtn.MouseEnter:Connect(function()
    TweenService:Create(resetBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(60, 60, 70)}):Play()
end)
resetBtn.MouseLeave:Connect(function()
    TweenService:Create(resetBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}):Play()
end)

-- Footer
local footer = Instance.new("Frame")
footer.Size = UDim2.new(1, 0, 0, 25)
footer.Position = UDim2.new(0, 0, 1, -25)
footer.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
footer.BackgroundTransparency = 0.5
footer.Parent = mainFrame

local versionLabel = Instance.new("TextLabel")
versionLabel.Size = UDim2.new(1, 0, 1, 0)
versionLabel.BackgroundTransparency = 1
versionLabel.Text = "Brainrot Helper v1.0 | Normal:59  |  On Speed:29"
versionLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
versionLabel.TextSize = 9
versionLabel.Font = Enum.Font.Gotham
versionLabel.Parent = footer

-- Drag functionality
local dragging = false
local dragStart
local frameStart

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        frameStart = mainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(frameStart.X.Scale, frameStart.X.Offset + delta.X, frameStart.Y.Scale, frameStart.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

print("[Brainrot Helper] Loaded successfully!")
if hasGetConnections then
    print("[Brainrot Helper] ✅ getconnections() verfügbar - Premium Steal Modus aktiv")
else
    print("[Brainrot Helper] ⚠️ getconnections() NICHT verfügbar - Verwende Fallback Modus")
    print("[Brainrot Helper] ⚠️ Steal Funktionen könnten eingeschränkt sein, aber ESP, Anti Ragdoll, etc. funktionieren")
end
print("[Brainrot Helper] Speed Settings: Normal=59 | On Speed=29")
